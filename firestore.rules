rules_version = '2';
// Audit Dossier Portal — Firestore security rules (paste in Firebase console → Firestore → Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function prof() { return get(profPath()).data; }
    function active() { return signedIn() && exists(profPath()) && prof().active == true; }
    function admin() { return active() && prof().role == 'Admin'; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }
    function myLc() { return prof().username_lc; }
    function auditor() { return active() && prof().role in ['Admin', 'Officer']; }
    function deptUser() { return active() && prof().role == 'Department'; }

    // first-run flag (public so the login page knows whether to show "First-time setup")
    match /meta/{id} {
      allow read: if true;
      allow create: if admin() && !setupDone();
      allow update, delete: if false;
    }

    // username -> internal login e-mail (public, needed before login)
    match /usernames/{name} {
      allow read: if true;
      allow create: if admin() || (signedIn() && !setupDone() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /users/{uid} {
      allow read: if active();
      allow create: if admin()
        || (signedIn() && !setupDone() && uid == request.auth.uid && request.resource.data.role == 'Admin');
      allow update: if admin()
        || (active() && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_login', 'closed_until', 'must_change']));
      allow delete: if admin();
    }

    match /tasks/{id}    { allow read: if active(); allow write: if admin(); }
    // task change log (old -> new) — admin only
    match /task_log/{id} { allow read, create, delete: if admin(); allow update: if false; }
    match /settings/{id} { allow read: if active(); allow write: if admin(); }
    match /monthly/{id}  { allow read: if active(); allow write: if admin(); }
    match /logs/{id}     { allow create: if active(); allow read: if admin(); }

    // today's ticks, shared live by everyone using the same login; moved to /records when the day closes
    match /marks/{id} {
      allow read: if admin() || (active() && resource.data.user_lc == myLc());
      allow create, update: if admin()
        || (active() && request.resource.data.user_lc == myLc() && request.resource.data.source in ['Portal', 'Extra', 'Trigger']);
      allow delete: if admin() || (active() && resource.data.user_lc == myLc());
    }

    // evidence pictures (compressed JPEG stored in the doc) — officers add their own, only admin deletes
    match /evidence/{id} {
      allow read: if admin() || (active() && resource.data.user_lc == myLc());
      allow create: if admin() || (active() && request.resource.data.user_lc == myLc()
        && request.resource.data.data is string && request.resource.data.data.size() < 900000);
      allow update: if admin();
      allow delete: if admin();
    }

    // audit issues: auditors raise and verify; a department login sees and answers only its own department
    match /issues/{id} {
      allow read: if auditor() || (deptUser() && resource.data.dept_lc == prof().dept_lc);
      allow create: if auditor() && request.resource.data.created_by_lc == myLc() && request.resource.data.status == 'Open';
      allow update: if auditor()
        || (deptUser() && resource.data.dept_lc == prof().dept_lc && resource.data.status != 'Verified'
            && request.resource.data.dept_lc == resource.data.dept_lc
            && request.resource.data.status in ['Open', 'Reopened', 'Done']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['due_date', 'due_set_by', 'due_set_at', 'status', 'dept_remarks',
                 'dept_evidence_ids', 'done_by', 'done_at', 'done_date', 'dept_seen', 'auditor_alert', 'history', 'updated_at']));
      allow delete: if admin();
    }
    match /issue_files/{id} {
      allow read: if auditor() || (deptUser() && resource.data.dept_lc == prof().dept_lc);
      allow create: if (auditor() || (deptUser() && request.resource.data.dept_lc == prof().dept_lc))
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow update: if false;
      allow delete: if admin();
    }
    // running number for AUD-0001, AUD-0002 …
    match /counters/{id} {
      allow read: if active();
      allow create: if auditor() && request.resource.data.n == 1;
      allow update: if auditor() && request.resource.data.n == resource.data.n + 1;
      allow write: if admin();   // admin can reset the numbering
    }

    // date-wise TRUE / FALSE — officers only see and write their own
    match /records/{id} {
      allow read: if admin() || (active() && resource.data.user_lc == myLc());
      allow create: if admin()
        || (active() && request.resource.data.user_lc == myLc()
            && request.resource.data.source in ['Portal', 'Extra', 'Trigger', 'Auto-Closed']);
      allow update: if admin()
        || (active() && resource.data.user_lc == myLc() && request.resource.data.user_lc == myLc()
            && resource.data.source != 'Auto-Closed' && resource.data.source != 'Admin'
            && request.resource.data.source in ['Portal', 'Extra', 'Trigger']
            && request.resource.data.date == resource.data.date);
      allow delete: if admin();
    }
  }
}
